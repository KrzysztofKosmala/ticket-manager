@baseUrl = http://localhost:8111

### Search the indexed knowledge. Run ingestion once before this request.
POST {{baseUrl}}/internal/knowledge/search
Content-Type: application/json

{
  "query": "Co oznacza status platnosci PAID?",
  "topK": 3
}

