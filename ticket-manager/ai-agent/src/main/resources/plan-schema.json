{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "intent", "steps"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "intent": {
      "type": "string",
      "enum": ["ORDER_INQUIRY", "PROMOTION_INQUIRY", "KNOWLEDGE_INQUIRY", "UNKNOWN"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "requiresConfirmation"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["TOOL", "KNOWLEDGE_SEARCH", "ANSWER", "ASK_CLARIFY"]
          },
          "name": {
            "type": ["string", "null"]
          },
          "args": {
            "type": ["object", "null"]
          },
          "constraints": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            }
          },
          "requiresConfirmation": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "constraints": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "fallback": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
