{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["intent", "steps"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["GET_USER_ORDERS", "GET_PROMO_TERMS", "QNA_KNOWLEDGE", "UNKNOWN"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["TOOL", "RAG", "ANSWER", "ASK_CLARIFY", "ASYNC_JOB"]
          },
          "name": { "type": ["string", "null"] },
          "args": { "type": ["object", "null"] },
          "constraints": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "constraints": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "fallback": { "type": ["string","null"] }
  },
  "additionalProperties": false
}